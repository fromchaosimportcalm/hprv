# HPRV — environment template
#
# House convention (see clintonops-infra README): .env.example is
# committed with no real values; the real file is never committed.
#
# On the container this lives at /etc/hprv/hprv.env, owned root:acore,
# mode 640. scripts/phase-a-bootstrap.sh generates it on first run —
# you only need this template if you are provisioning by hand or
# reconstructing a lost container.
#
# Consumed by:
#   - Phase E authserver.conf / worldserver.conf DB connection strings
#   - systemd units, via EnvironmentFile=/etc/hprv/hprv.env

ACORE_DB_HOST=127.0.0.1
ACORE_DB_PORT=3306
ACORE_DB_USER=acore
ACORE_DB_PASS=REPLACE_WITH_SECURE_PASS
ACORE_DB_AUTH=acore_auth
ACORE_DB_CHARACTERS=acore_characters
ACORE_DB_WORLD=acore_world
# Fourth schema, owned by mod-playerbots — NOT part of stock AzerothCore.
# worldserver reads it as PlayerbotsDatabaseInfo; the module ships
# data/sql/playerbots/{base,updates} against it. Added 2026-08-05 after
# the Phase B clone showed the module expects it.
ACORE_DB_PLAYERBOTS=acore_playerbots
